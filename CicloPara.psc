Algoritmo CicloPara
	
	Definir num, rep, notass Como Entero
	
	Dimension notass[10] // Este es un arreglo de 10 notas
	notass[1] <- 90
	notass[2] <- 70
	notass[3] <- 80
	notass[4] <- 20
	
	
	
	Escribir "Ingrese un numero de repeticiones"
	Leer rep
	Para num <- 0 Hasta rep Con Paso 1 Hacer
		
		Escribir "Esta es la rep ", num
	FinPara
	
FinAlgoritmo
